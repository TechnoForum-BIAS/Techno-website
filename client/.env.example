# Vite Client Environment Configuration
# In local development, leave empty to automatically route through Vite proxy (/api -> http://localhost:5000)
VITE_API_BASE_URL=

# Optional: If client directly communicates with Supabase (e.g. Supabase Storage downloads)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
