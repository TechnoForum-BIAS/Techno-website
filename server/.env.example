PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Official Super Admin Email
ADMIN_EMAIL=techno_forum@birlainstitute.co.in

# Supabase Credentials (Get from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret for Session Authentication
JWT_SECRET=technoforum_super_secret_jwt_key_2026

# Brevo (formerly Sendinblue) SMTP Configuration
# Get credentials at https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-account-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key-here
EMAIL_FROM=Technoforum BIAS <noreply@technoforum.bias.ac.in>

# Optional: Google OAuth Client ID (From https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Optional: Google Gemini Vision API Key (For AI Component Identification)
# Interns can get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
